{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "RunLog": {
      "LogLevel": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Polly": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ReviewAgent": "Data Source=review-agent.db"
  },
  "Storage": {
    "DataDirectory": "data"
  },
  "Agent": {
    "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "Model": "gemini-3.5-flash-lite",
    "McpServerUrl": "http://localhost:5090/",
    "MaxToolRounds": 40,
    "RequestTimeout": "00:02:00",
    "Timeout": "00:05:00",
    "RequestsPerMinute": 15,
    "Verifier": {
      "Enabled": true
    }
  }
}
