{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ReviewAgent": "Data Source=review-agent.db"
  },
  "PullRequests": {
    "Source": "Saved",
    "SavedDirectory": "samples/pull-requests",
    "GitHub": {
      "ApiUrl": "https://api.github.com/"
    }
  },
  "Agent": {
    "Endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "Model": "gemini-3.5-flash-lite",
    "McpServerUrl": "http://localhost:5090/",
    "TeamRulesPath": ".review/rules.md",
    "MaxToolRounds": 40,
    "RequestTimeout": "00:02:00",
    "Timeout": "00:05:00"
  }
}
