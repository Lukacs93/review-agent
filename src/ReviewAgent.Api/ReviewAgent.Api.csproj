<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ReviewAgent.Api</RootNamespace>
    <UserSecretsId>review-agent-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" />
  </ItemGroup>

  <!-- The saved pull requests, reviewed without GitHub; copied next to the application, read-only. -->
  <ItemGroup>
    <Content Include="..\..\samples\**\*" LinkBase="samples" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReviewAgent.Application\ReviewAgent.Application.csproj" />
    <ProjectReference Include="..\ReviewAgent.Infrastructure\ReviewAgent.Infrastructure.csproj" />
    <ProjectReference Include="..\ReviewAgent.ServiceDefaults\ReviewAgent.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
